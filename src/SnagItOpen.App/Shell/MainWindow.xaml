<Window x:Class="SnagItOpen.App.Shell.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:ed="clr-namespace:SnagItOpen.App.Editor" xmlns:inf="clr-namespace:SnagItOpen.App.Infrastructure" xmlns:ui="clr-namespace:SnagItOpen.App.Controls"
 Title="{Binding Title}" Width="1280" Height="820" MinWidth="640" MinHeight="420" AllowDrop="True" UseLayoutRounding="True" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Primary}" FontFamily="{DynamicResource Font.UI}" FontSize="12">
 <Window.Resources><inf:NotNullToVisibilityConverter x:Key="NotNullVis" /></Window.Resources>
 <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New composition" InputGestureText="Ctrl+N" Click="OnNew" />
                <MenuItem Header="_Import images…" InputGestureText="Ctrl+O" Click="OnImport" />
                <MenuItem Header="_Open project…" InputGestureText="Ctrl+Shift+O" Click="OnOpenProject" />
                <Separator />
                <MenuItem x:Name="RecentProjectsMenu" Header="Open _recent" />
                <MenuItem Header="_Save project" InputGestureText="Ctrl+S" Click="OnSave" />
                <MenuItem Header="Save project _as…" InputGestureText="Ctrl+Shift+S" Click="OnSaveAs" />
                <Separator />
                <MenuItem Header="_Export image…" InputGestureText="Ctrl+E" Click="OnExport" />
                <MenuItem Header="_Copy image" InputGestureText="Ctrl+Shift+C" Click="OnCopy" />
                <MenuItem Header="_Pin to screen" Click="OnPin" />
                <Separator />
                <MenuItem Header="Recent _captures…" Click="OnLibrary" />
                <MenuItem Header="Se_ttings…" Click="OnSettings" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoLabel}" InputGestureText="Ctrl+Z" Click="OnUndo" />
                <MenuItem Header="{Binding RedoLabel}" InputGestureText="Ctrl+Y" Click="OnRedo" />
                <Separator />
                <MenuItem Header="_Paste image" InputGestureText="Ctrl+V" Click="OnPaste" />
                <MenuItem Header="_Duplicate" InputGestureText="Ctrl+D" Click="OnDuplicate" />
                <MenuItem Header="_Group" InputGestureText="Ctrl+G" Click="OnGroup" />
                <MenuItem Header="_Ungroup" InputGestureText="Ctrl+Shift+G" Click="OnUngroup" />
                <MenuItem Header="De_lete" InputGestureText="Del" Click="OnDelete" />
                <MenuItem Header="Select _all" InputGestureText="Ctrl+A" Click="OnSelectAll" />
                <Separator />
                <MenuItem Header="Rotate _left" Click="OnRotateLeft" />
                <MenuItem Header="Rotate _right" Click="OnRotateRight" />
                <MenuItem Header="Flip _horizontal" Click="OnFlipH" />
                <MenuItem Header="Flip _vertical" Click="OnFlipV" />
                <Separator />
                <MenuItem Header="Bring to front" InputGestureText="Ctrl+Shift+]" Click="OnToFront" />
                <MenuItem Header="Bring forward" InputGestureText="Ctrl+]" Click="OnForward" />
                <MenuItem Header="Send backward" InputGestureText="Ctrl+[" Click="OnBackward" />
                <MenuItem Header="Send to back" InputGestureText="Ctrl+Shift+[" Click="OnToBack" />
                <Separator />
                <MenuItem Header="Reset crop" Click="OnResetCrop" />
                <MenuItem Header="Remove blur/pixelate" Click="OnClearEffects" />
                <MenuItem Header="Renumber steps" Click="OnRenumber" />
            </MenuItem>
            <MenuItem Header="_Layout">
                <MenuItem Header="Combine _vertically" IsCheckable="True" IsChecked="{Binding IsVertical, Mode=OneWay}" Click="OnVertical" />
                <MenuItem Header="Combine _horizontally" IsCheckable="True" IsChecked="{Binding IsHorizontal, Mode=OneWay}" Click="OnHorizontal" />
                <MenuItem Header="_Free canvas" IsCheckable="True" IsChecked="{Binding IsFree, Mode=OneWay}" Click="OnFree" />
                <Separator />
                <MenuItem x:Name="PresetsMenu" Header="_Presets" SubmenuOpened="OnPresetsOpened">
                    <MenuItem Header="(loading)" />
                </MenuItem>
                <MenuItem Header="Save layout as preset…" Click="OnSavePreset" />
                <Separator />
                <MenuItem Header="Fit canvas to content" Click="OnFitCanvas" />
                <MenuItem Header="Canvas size…" Click="OnCanvasSize" />
                <MenuItem Header="Scale document…" Click="OnScaleDocument" />
                <Separator />
                <MenuItem Header="Join overlapping images…" Click="OnJoinSeam" />
            </MenuItem>
            <MenuItem Header="_Capture">
                <MenuItem Header="_Region" InputGestureText="" Click="OnCaptureRegion" />
                <MenuItem Header="_Window (visible area)" Click="OnCaptureWindow" />
                <MenuItem Header="_Monitor under cursor" Click="OnCaptureMonitor" />
                <MenuItem Header="_All monitors" Click="OnCaptureAll" />
                <MenuItem Header="_Last region" Click="OnCaptureLast" />
                <Separator />
                <MenuItem Header="_Ellipse region" Click="OnCaptureEllipse" />
                <MenuItem Header="_Freehand region" Click="OnCaptureFreehand" />
                <MenuItem Header="Fi_xed size…" Click="OnCaptureFixed" />
                <MenuItem Header="Fixed as_pect…" Click="OnCaptureAspect" />
                <MenuItem Header="M_ultiple regions" Click="OnCaptureMulti" />
                <Separator />
                <MenuItem Header="_Scrolling capture…" Click="OnScrolling" />
                <MenuItem Header="_Interval capture…" Click="OnInterval" />
                <Separator />
                <MenuItem x:Name="DestinationMenu" Header="_Destination" />
                <MenuItem x:Name="DelayMenu" Header="De_lay" />
                <MenuItem x:Name="CursorMenu" Header="Include _cursor" IsCheckable="True" Click="OnToggleCursor" />
                <Separator />
                <MenuItem x:Name="CapturePresetsMenu" Header="Capture presets" SubmenuOpened="OnCapturePresetsOpened">
                    <MenuItem Header="(none)" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Fit to window" InputGestureText="Ctrl+0" Click="OnZoomFit" />
                <MenuItem Header="Actual size (100%)" InputGestureText="Ctrl+1" Click="OnZoom100" />
                <MenuItem Header="Zoom _in" InputGestureText="Ctrl++" Click="OnZoomIn" />
                <MenuItem Header="Zoom _out" InputGestureText="Ctrl+-" Click="OnZoomOut" />
                <Separator />
                <MenuItem Header="Command _palette" InputGestureText="Ctrl+K" Click="OnCommandPalette" />
                <MenuItem Header="Zoom to selection" InputGestureText="Ctrl+2" Click="OnZoomSelection" />
                <MenuItem Header="Fit width" Click="OnFitWidth" />
                <MenuItem x:Name="ClassicMenu" Header="Classic toolbar" IsCheckable="True" Click="OnClassicToolbar" />
                <MenuItem Header="Layers panel" Click="OnToggleLayers" />
                <MenuItem Header="Properties inspector" InputGestureText="F4" Click="OnToggleProperties" />
                <MenuItem x:Name="GalleryMenu" Header="Recent captures _strip" IsCheckable="True" Click="OnToggleGallery" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Keyboard shortcuts" InputGestureText="F1" Click="OnShortcuts" />
                <MenuItem Header="_About SnagItOpen" Click="OnAbout" />
            </MenuItem>
        </Menu>
 <Border DockPanel.Dock="Top" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,0,0,1" MinHeight="44">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="CommandBar" Orientation="Horizontal" Margin="8,4" KeyboardNavigation.TabNavigation="Once" /></ScrollViewer>
 </Border>
 <ToolBar x:Name="ToolsBar" DockPanel.Dock="Top" Visibility="Collapsed" />
 <StatusBar x:Name="StatusRegion" DockPanel.Dock="Bottom" MinHeight="28">
  <StatusBarItem HorizontalContentAlignment="Stretch"><DockPanel><Path x:Name="StatusIcon" Width="14" Height="14" Data="{DynamicResource Icon.Info}" Stroke="{DynamicResource Status.Info}" StrokeThickness="1.5" Stretch="Uniform" Margin="0,0,6,0" /><TextBlock Text="{Binding Status}" ToolTip="{Binding Status}" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" /></DockPanel></StatusBarItem>
  <StatusBarItem HorizontalAlignment="Right"><StackPanel Orientation="Horizontal">
   <TextBlock Text="{Binding SelectionInfo}" VerticalAlignment="Center" Margin="0,0,12,0" />
   <Button Style="{DynamicResource SubtleButton}" MinHeight="24" Padding="8,2" Content="{Binding CanvasSize}" Click="OnCanvasSize" ToolTip="Canvas properties" Margin="0,0,8,0" />
   <Border Width="1" Height="16" Background="{DynamicResource Stroke.Divider}" Margin="0,0,8,0" />
   <ui:IconButton Label="Zoom out" ShowLabel="False" Icon="{DynamicResource Icon.Minus}" Width="24" Height="24" MinWidth="24" MinHeight="24" Click="OnZoomOut" />
   <ui:NumberBox x:Name="ZoomBox" Width="52" Minimum="10" Maximum="800" Value="100" AutomationProperties.Name="Zoom percent" />
   <TextBlock Text="%" VerticalAlignment="Center" Margin="3,0,2,0" Foreground="{DynamicResource Text.Secondary}" />
   <ui:IconButton Label="Zoom options" ShowLabel="False" Icon="{DynamicResource Icon.ChevronDown}" IconSize="12" Width="20" Height="24" MinWidth="20" MinHeight="24" Click="OnZoomMenu" />
   <ui:IconButton Label="Zoom in" ShowLabel="False" Icon="{DynamicResource Icon.Plus}" Width="24" Height="24" MinWidth="24" MinHeight="24" Click="OnZoomIn" />
  </StackPanel></StatusBarItem>
 </StatusBar>
 <Grid x:Name="WorkspaceGrid">
  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="ListColumn" Width="220" MinWidth="0" />
   <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" MinWidth="320" /><ColumnDefinition Width="Auto" /><ColumnDefinition x:Name="PropsColumn" Width="300" MinWidth="0" /></Grid.ColumnDefinitions>
  <Grid Grid.Column="0" Width="48">
   <ScrollViewer x:Name="RailScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" Background="{DynamicResource Bg.Window}"><StackPanel x:Name="ToolRail" Margin="6" KeyboardNavigation.TabNavigation="Once" /></ScrollViewer>
   <!-- V23: fades out the last visible tools when more are below (scroll with the wheel). -->
   <Border x:Name="RailFade" Height="28" VerticalAlignment="Bottom" IsHitTestVisible="False" Background="{DynamicResource Bg.Window}" Visibility="Collapsed">
    <Border.OpacityMask><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="Transparent" Offset="0" /><GradientStop Color="Black" Offset="0.85" /></LinearGradientBrush></Border.OpacityMask>
   </Border>
  </Grid>
            <TabControl x:Name="LeftTabs" Grid.Column="1" Margin="4" Padding="0">
            <TabItem Header="Images">
            <DockPanel Margin="2">
                <TextBlock DockPanel.Dock="Top" Text="Layout order" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="2,0,0,4" />
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                    <ui:IconButton Label="Move earlier in the combine order" Shortcut="Alt+Up" ShowLabel="False" Icon="M8,13 L8,3 M4,7 L8,3 L12,7" Click="OnMoveUp" />
                    <ui:IconButton Label="Move later in the combine order" Shortcut="Alt+Down" ShowLabel="False" Icon="M8,3 L8,13 M4,9 L8,13 L12,9" Click="OnMoveDown" />
                    <ui:IconButton Label="Show or hide the selected image" ShowLabel="False" Icon="{DynamicResource Icon.Eye}" Click="OnToggleHidden" />
                    <ui:IconButton Label="Remove the selected images" Shortcut="Del" ShowLabel="False" Icon="{DynamicResource Icon.Trash}" Click="OnDelete" />
                </StackPanel>
                <ListBox x:Name="ImageList" ItemsSource="{Binding Images}" SelectionMode="Extended" AllowDrop="True"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Images in combine order"
                         SelectionChanged="OnListSelectionChanged" PreviewMouseLeftButtonDown="OnListMouseDown"
                         PreviewMouseMove="OnListMouseMove" Drop="OnListDrop" DragOver="OnListDragOver" KeyDown="OnListKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                            <Setter Property="Padding" Value="2" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Width="52" Height="40" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" Background="{DynamicResource Bg.SurfaceAlt}">
                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <StackPanel Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Dimensions}" Opacity="0.7" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            </TabItem>
            <TabItem Header="Objects">
                <ContentControl x:Name="ObjectsHost" Focusable="False" />
            </TabItem>
            </TabControl>


  <ui:IconButton x:Name="LayersStrip" Grid.Column="1" Label="Expand Layers" ShowLabel="False" Icon="{DynamicResource Icon.ChevronRight}" Click="OnToggleLayers" Visibility="Collapsed" VerticalAlignment="Top" Margin="4,8,4,0" />
  <GridSplitter Grid.Column="2" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Stroke.Divider}" Focusable="False" />
  <DockPanel Grid.Column="3">
   <Border x:Name="GalleryHost" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="0,1,0,0" />
   <ui:InfoBar x:Name="OutsideWarning" DockPanel.Dock="Top" Kind="Warning" Title="Content outside canvas" Message="Content outside the locked canvas will be cut off." Visibility="Collapsed" />
   <ui:InfoBar x:Name="HiddenWarning" DockPanel.Dock="Top" Title="All content is hidden" Message="Show all content to include it in the result." Visibility="Collapsed" />
   <ui:InfoBar x:Name="FirstRunTip" DockPanel.Dock="Top" Title="Capture from anywhere" Visibility="Collapsed" />
   <Grid x:Name="CanvasRegion" ClipToBounds="True">
    <ed:CanvasView x:Name="Canvas" />
    <Canvas x:Name="TextEditorLayer" ClipToBounds="True" IsHitTestVisible="True" Background="{x:Null}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" Margin="24" Visibility="{Binding IsEmpty, Converter={StaticResource NotNullVis}}">
                    <Border Background="{DynamicResource Bg.Surface}" CornerRadius="10" Padding="24" MaxWidth="560" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource Accent.Brand}" VerticalAlignment="Center">
                                    <TextBlock Text="S" Foreground="{DynamicResource Text.OnAccent}" FontSize="24" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0" />
                                </Border>
                                <TextBlock Text="Start a capture" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock Text="Capture part of the screen, import images, or drop files anywhere in this window."
                                       FontSize="13" Foreground="{DynamicResource Text.Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,20" />

                            <UniformGrid Columns="3">
                                <Button Style="{StaticResource StartPrimaryButton}" Click="OnCaptureRegion" AutomationProperties.Name="Capture region">
                                    <StackPanel>
                                        <TextBlock Text="Capture region" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock x:Name="StartRegionKeyInline" Text="PrintScreen" FontSize="11" Opacity="0.85" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource StartButton}" Click="OnImport" AutomationProperties.Name="Import images">
                                    <StackPanel>
                                        <TextBlock Text="Import images…" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Ctrl+O" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource StartButton}" Click="OnPaste" AutomationProperties.Name="Paste an image">
                                    <StackPanel>
                                        <TextBlock Text="Paste" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                        <TextBlock Text="Ctrl+V" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Button>
                            </UniformGrid>

                            <Grid Margin="0,16,0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Recent projects" FontWeight="SemiBold" /><StackPanel x:Name="StartProjects" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0"><TextBlock Text="Recent captures" FontWeight="SemiBold" /><WrapPanel x:Name="StartCaptures" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,24,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Height="1" Background="{DynamicResource Stroke.Divider}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="SHORTCUTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" Margin="10,0" />
                                <Border Grid.Column="2" Height="1" Background="{DynamicResource Stroke.Divider}" VerticalAlignment="Center" />
                            </Grid>

                            <WrapPanel x:Name="StartShortcuts" />

                            <TextBlock HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="12">
                                <Hyperlink Click="OnShortcuts" Foreground="{DynamicResource Accent.Brand}">All keyboard shortcuts</Hyperlink>
                                <Run Text="  ·  " Foreground="{DynamicResource Text.Secondary}" />
                                <Hyperlink Click="OnSettings" Foreground="{DynamicResource Accent.Brand}">Change shortcuts</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

    <ui:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" />
   </Grid>
  </DockPanel>
  <GridSplitter Grid.Column="4" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource Stroke.Divider}" Focusable="False" />
  <ContentControl x:Name="InspectorHost" Grid.Column="5" Focusable="False" />
  <Button x:Name="InspectorStrip" Grid.Column="5" Content="‹" Click="OnToggleProperties" Visibility="Collapsed" VerticalAlignment="Top" Height="36" AutomationProperties.Name="Expand properties" />
  <Popup x:Name="PropertiesFlyout" PlacementTarget="{Binding ElementName=CanvasRegion}" Placement="Relative" StaysOpen="False" AllowsTransparency="True"><Border x:Name="FlyoutHost" Width="300" MaxHeight="660" Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Stroke.Divider}" BorderThickness="1" /></Popup>
 </Grid>
 </DockPanel>
</Window>
