<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme colour tokens (PRD 5.2). Every token file must define exactly the same keys. -->
    <SolidColorBrush x:Key="Bg.Window" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Bg.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="#F9F9F9" />
    <SolidColorBrush x:Key="Bg.Canvas" Color="#E8E8E8" />
    <SolidColorBrush x:Key="Bg.Control" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Bg.ControlHover" Color="#F0F0F0" />
    <SolidColorBrush x:Key="Bg.ControlPressed" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#E1ECF9" />
    <SolidColorBrush x:Key="Stroke.Divider" Color="#E0E0E0" />
    <SolidColorBrush x:Key="Stroke.Control" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Stroke.Focus" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Text.Primary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5C5C5C" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#A0A0A0" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Accent.Brand" Color="#C81E26" />
    <SolidColorBrush x:Key="Accent.BrandHover" Color="#A3141B" />
    <SolidColorBrush x:Key="Accent.Select" Color="#0067C0" />
    <SolidColorBrush x:Key="Accent.SelectSoft" Color="#330067C0" />
    <SolidColorBrush x:Key="Accent.Guide" Color="#E3008C" />
    <SolidColorBrush x:Key="Status.Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Status.Warning" Color="#9D5D00" />
    <SolidColorBrush x:Key="Status.Error" Color="#C42B1C" />
    <SolidColorBrush x:Key="Status.Info" Color="#0067C0" />
    <SolidColorBrush x:Key="Checker.A" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Checker.B" Color="#D9D9D9" />
    <SolidColorBrush x:Key="Overlay.Dim" Color="#6E000000" />
    <SolidColorBrush x:Key="Handle.Fill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Handle.Special" Color="#FFB900" />
</ResourceDictionary>
