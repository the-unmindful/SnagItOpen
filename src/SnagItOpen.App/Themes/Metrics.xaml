<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Shared metrics for every theme (PRD 5.3, 5.4). No colours here. -->

    <!-- Spacing scale: 2, 4, 8, 12, 16, 24, 32 -->
    <sys:Double x:Key="Space.1">2</sys:Double>
    <sys:Double x:Key="Space.2">4</sys:Double>
    <sys:Double x:Key="Space.3">8</sys:Double>
    <sys:Double x:Key="Space.4">12</sys:Double>
    <sys:Double x:Key="Space.5">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.7">32</sys:Double>
    <Thickness x:Key="Pad.1">2</Thickness>
    <Thickness x:Key="Pad.2">4</Thickness>
    <Thickness x:Key="Pad.3">8</Thickness>
    <Thickness x:Key="Pad.4">12</Thickness>
    <Thickness x:Key="Pad.5">16</Thickness>
    <Thickness x:Key="Pad.Control">8,4,8,4</Thickness>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Control">4</CornerRadius>
    <CornerRadius x:Key="Radius.Card">8</CornerRadius>
    <CornerRadius x:Key="Radius.Toast">8</CornerRadius>

    <!-- Heights -->
    <sys:Double x:Key="Height.Control">28</sys:Double>
    <sys:Double x:Key="Height.ControlTouch">32</sys:Double>
    <sys:Double x:Key="Height.ToolButton">36</sys:Double>
    <sys:Double x:Key="Height.TitleBar">40</sys:Double>
    <sys:Double x:Key="Height.CommandBar">44</sys:Double>
    <sys:Double x:Key="Height.StatusBar">28</sys:Double>
    <sys:Double x:Key="Size.MinHit">24</sys:Double>

    <!-- Type -->
    <FontFamily x:Key="Font.UI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="FontSize.Caption">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">12</sys:Double>
    <sys:Double x:Key="FontSize.Subtitle">14</sys:Double>
    <sys:Double x:Key="FontSize.Title">20</sys:Double>

    <!-- Motion (ThemeService.AnimationsEnabled decides whether to use them) -->
    <Duration x:Key="Motion.Fast">0:0:0.083</Duration>
    <Duration x:Key="Motion.Normal">0:0:0.167</Duration>
    <Duration x:Key="Motion.Slow">0:0:0.25</Duration>
</ResourceDictionary>
