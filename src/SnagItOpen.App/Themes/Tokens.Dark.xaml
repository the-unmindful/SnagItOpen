<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme colour tokens (PRD 5.2). Same keys as Tokens.Light.xaml. -->
    <SolidColorBrush x:Key="Bg.Window" Color="#202020" />
    <SolidColorBrush x:Key="Bg.Surface" Color="#2B2B2B" />
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="#323232" />
    <SolidColorBrush x:Key="Bg.Canvas" Color="#1A1A1A" />
    <SolidColorBrush x:Key="Bg.Control" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Bg.ControlHover" Color="#454545" />
    <SolidColorBrush x:Key="Bg.ControlPressed" Color="#505050" />
    <SolidColorBrush x:Key="Bg.Selected" Color="#1F3A5C" />
    <SolidColorBrush x:Key="Stroke.Divider" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Stroke.Control" Color="#5A5A5A" />
    <SolidColorBrush x:Key="Stroke.Focus" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Primary" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#BDBDBD" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#6E6E6E" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Text.Selected" Color="#F2F2F2" />
    <SolidColorBrush x:Key="Accent.Brand" Color="#E0474E" />
    <SolidColorBrush x:Key="Accent.BrandHover" Color="#F0666C" />
    <SolidColorBrush x:Key="Accent.Select" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Accent.SelectSoft" Color="#334CC2FF" />
    <SolidColorBrush x:Key="Accent.Guide" Color="#FF4FB8" />
    <SolidColorBrush x:Key="Status.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Status.Warning" Color="#FCE100" />
    <SolidColorBrush x:Key="Status.Error" Color="#FF99A4" />
    <SolidColorBrush x:Key="Status.Info" Color="#4CC2FF" />
    <SolidColorBrush x:Key="Checker.A" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Checker.B" Color="#2E2E2E" />
    <SolidColorBrush x:Key="Overlay.Dim" Color="#6E000000" />
    <SolidColorBrush x:Key="Handle.Fill" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Handle.Special" Color="#FFB900" />
</ResourceDictionary>
