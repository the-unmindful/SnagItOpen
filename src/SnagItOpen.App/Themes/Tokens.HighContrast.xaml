<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- High-contrast tokens (PRD 5.2). Same keys as Tokens.Light.xaml, mapped to system colours.
         Values are read when the dictionary is loaded; ThemeService reloads it when the system palette changes. -->
    <SolidColorBrush x:Key="Bg.Window" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.Surface" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.SurfaceAlt" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Bg.Canvas" Color="{x:Static SystemColors.AppWorkspaceColor}" />
    <SolidColorBrush x:Key="Bg.Control" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Bg.ControlHover" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Bg.ControlPressed" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Bg.Selected" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Stroke.Divider" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Stroke.Control" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Stroke.Focus" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Primary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Secondary" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Text.Disabled" Color="{x:Static SystemColors.GrayTextColor}" />
    <SolidColorBrush x:Key="Text.OnAccent" Color="{x:Static SystemColors.HighlightTextColor}" />
    <SolidColorBrush x:Key="Accent.Brand" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.BrandHover" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Accent.Select" Color="{x:Static SystemColors.HighlightColor}" />
    <SolidColorBrush x:Key="Accent.SelectSoft" Color="{x:Static SystemColors.HighlightColor}" Opacity="0.25" />
    <SolidColorBrush x:Key="Accent.Guide" Color="{x:Static SystemColors.HotTrackColor}" />
    <SolidColorBrush x:Key="Status.Success" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Status.Warning" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Status.Error" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Status.Info" Color="{x:Static SystemColors.WindowTextColor}" />
    <SolidColorBrush x:Key="Checker.A" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Checker.B" Color="{x:Static SystemColors.ControlColor}" />
    <SolidColorBrush x:Key="Overlay.Dim" Color="#6E000000" />
    <SolidColorBrush x:Key="Handle.Fill" Color="{x:Static SystemColors.WindowColor}" />
    <SolidColorBrush x:Key="Handle.Special" Color="{x:Static SystemColors.HighlightColor}" />
</ResourceDictionary>
