<Application x:Class="SnagItOpen.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Index 0 is the colour token set; ThemeService swaps it at runtime. -->
                <ResourceDictionary Source="/SnagItOpen;component/Themes/Tokens.Light.xaml" />
                <ResourceDictionary Source="/SnagItOpen;component/Themes/Metrics.xaml" />
                <ResourceDictionary Source="/SnagItOpen;component/Themes/Icons.xaml" />
                <ResourceDictionary Source="/SnagItOpen;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
